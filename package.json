{
  "name": "@solodev1911/second-brain",
  "version": "0.1.0-beta.1",
  "description": "Explicit-save, source-linked project memory for Pi, backed by Graphify",
  "type": "module",
  "license": "Apache-2.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solodev1911/second-brain-pi.git"
  },
  "homepage": "https://github.com/solodev1911/second-brain-pi#readme",
  "bugs": {
    "url": "https://github.com/solodev1911/second-brain-pi/issues"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "graphify",
    "second-brain",
    "agent-memory",
    "knowledge-graph",
    "local-first"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions/",
    "src/",
    "skills/",
    "scripts/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "SUPPORT.md",
    "docs/",
    "graphify/graphify/",
    "graphify/pyproject.toml",
    "graphify/uv.lock",
    "graphify/README.md",
    "graphify/LICENSE",
    "graphify/LICENSE-MIT",
    "graphify/NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "pi": {
    "extensions": [
      "./extensions/second-brain.ts"
    ],
    "skills": [
      "./skills/second-brain"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:rpc": "vitest run tests/rpc",
    "test:live": "node --import tsx scripts/live-smoke.ts",
    "check": "npm run typecheck && npm run test:unit && npm run test:contract && npm run test:rpc",
    "pack:check": "node --import tsx scripts/pack-check.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "26.6.1",
    "tsx": "4.23.13",
    "typebox": "1.3.34",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
